# Copy to apps/web/.env.local and fill in. Never commit real values.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo sign-in as the seeded Northwind owner. Local/CI/preview only, NEVER production.
DEMO_SIGN_IN=true

# Supabase (local values: `pnpm exec supabase status -o env` → API_URL, ANON_KEY, SERVICE_ROLE_KEY)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub App (phase 2) — one App for sign-in and repo access
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Inngest (phase 3; not needed with the local dev server)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Stripe (phase 4)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email
RESEND_API_KEY=

# Observability (phase 4)
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
